# Acadlyx backend — copy to .env for local development. Never commit .env.
# Production values come from AWS Secrets Manager / task environment (Phase 15).

NODE_ENV=development
PORT=4000

# Local PostgreSQL (see docs/development/local-setup.md). Replace the passwords.
# Platform/owner role: migrations, Platform Admin, tenant resolution (BYPASSRLS).
DATABASE_URL=postgresql://acadlyx:change_me@localhost:5432/acadlyx?schema=public
# Restricted tenant-scoped role: every query is filtered by Row Level Security.
DATABASE_APP_URL=postgresql://acadlyx_app:change_me_too@localhost:5432/acadlyx?schema=public

REDIS_URL=redis://localhost:6379/0

# Comma-separated exact origins allowed by CORS (no wildcards).
CORS_ORIGINS=http://localhost:4001,http://localhost:4002

# Public base URL of this API (used for links/logging; no trailing slash).
API_PUBLIC_URL=http://localhost:4000

# fatal | error | warn | info | debug | trace | silent
LOG_LEVEL=debug

# Max JSON/urlencoded request body size (e.g. 1mb).
BODY_LIMIT=1mb

# Global rate-limit foundation: max requests per window per client.
RATE_LIMIT_TTL_MS=60000
RATE_LIMIT_MAX=300

# Set when running behind a load balancer/proxy (e.g. 1). 0 = disabled.
TRUST_PROXY=0

# ---- Phase 3 authentication secrets (development placeholders — NOT usable values) ----------
# Generate real values with: pnpm --filter @acadlyx/backend auth:keys
# Each *_KEYS value is a JSON object {"<keyId>":"<base64 key>"}; *_ACTIVE_KID selects the key
# for new signatures/ciphertexts. Keep old ids listed during rotation. Never commit real keys.
AUTH_JWT_ISSUER=acadlyx
AUTH_JWT_PRIVATE_KEYS={"replace-me":"<base64 Ed25519 PKCS#8 DER from auth:keys>"}
AUTH_JWT_ACTIVE_KID=replace-me
AUTH_ENCRYPTION_KEYS={"replace-me":"<base64 32 random bytes>"}
AUTH_ENCRYPTION_ACTIVE_KID=replace-me
AUTH_HMAC_KEYS={"replace-me":"<base64 32+ random bytes>"}
AUTH_HMAC_ACTIVE_KID=replace-me

# OTP delivery: dev = local Redis outbox (development/test only), none = fail closed.
OTP_DELIVERY=dev
