{
  "name": "@acadlyx/backend",
  "version": "0.1.0",
  "private": true,
  "description": "Acadlyx core backend — NestJS modular monolith",
  "type": "module",
  "scripts": {
    "prebuild": "pnpm prisma:generate",
    "build": "nest build",
    "dev": "pnpm prisma:generate && nest start --watch",
    "start": "node dist/main.js",
    "typecheck": "pnpm prisma:generate && tsc -p tsconfig.json --noEmit",
    "lint": "pnpm prisma:generate && eslint src test --max-warnings 0",
    "test": "pnpm prisma:generate && vitest run",
    "test:unit": "vitest run --project unit",
    "test:e2e": "vitest run --project e2e",
    "prisma:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:migrate:create": "prisma migrate dev --create-only",
    "db:migrate:deploy": "prisma migrate deploy",
    "db:status": "prisma migrate status",
    "db:reset": "prisma migrate reset",
    "clean": "rm -rf dist src/generated *.tsbuildinfo",
    "db:seed": "nest build && node --env-file-if-exists=.env dist/database/seed.js",
    "auth:keys": "nest build && node dist/cli/generate-auth-keys.js",
    "platform:create-admin": "nest build && node --env-file-if-exists=.env dist/cli/create-platform-admin.js"
  },
  "dependencies": {
    "@acadlyx/constants": "workspace:*",
    "@acadlyx/permissions": "workspace:*",
    "@acadlyx/tenant-config": "workspace:*",
    "@acadlyx/types": "workspace:*",
    "@acadlyx/validation": "workspace:*",
    "@nestjs/bullmq": "12.0.0",
    "@nestjs/common": "12.1.0",
    "@nestjs/config": "12.0.1",
    "@nestjs/core": "12.1.0",
    "@nestjs/platform-express": "12.1.0",
    "@nestjs/throttler": "6.7.1",
    "@prisma/adapter-pg": "7.10.0",
    "@prisma/client": "7.10.0",
    "argon2": "0.45.1",
    "bullmq": "6.3.9",
    "class-transformer": "0.5.1",
    "class-validator": "0.15.1",
    "csv-parse": "7.0.3",
    "exceljs": "4.4.0",
    "helmet": "8.3.0",
    "ioredis": "6.0.0",
    "jose": "6.2.12",
    "nestjs-pino": "5.2.1",
    "pino": "10.3.1",
    "pino-http": "11.0.0",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2"
  },
  "devDependencies": {
    "@nestjs/cli": "12.0.7",
    "@nestjs/schematics": "12.0.5",
    "@nestjs/testing": "12.1.0",
    "@swc/core": "1.16.2",
    "@types/express": "5.0.6",
    "@types/node": "22.20.4",
    "@types/pg": "8.23.1",
    "@types/supertest": "7.2.1",
    "dotenv": "18.0.4",
    "pg": "8.23.0",
    "pino-pretty": "13.1.3",
    "prisma": "7.10.0",
    "supertest": "7.3.0",
    "typescript": "6.0.3",
    "unplugin-swc": "2.0.0",
    "vitest": "4.1.11"
  }
}
