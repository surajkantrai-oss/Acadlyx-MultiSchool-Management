// Acadlyx database schema.
//
// Conventions: Prisma models are PascalCase/camelCase; database tables and columns are
// snake_case via @@map/@map. Primary keys are UUID v7. Every tenant-owned table carries
// tenant_id and is protected by PostgreSQL Row Level Security (see the
// phase_2_multi_tenancy migration and docs/architecture/MULTI_TENANCY.md).

generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "esm"
}

datasource db {
  provider = "postgresql"
}

/// Lifecycle rules live in @acadlyx/tenant-config (lifecycle.ts). ARCHIVED is terminal.
enum TenantStatus {
  DRAFT
  ACTIVE
  SUSPENDED
  INACTIVE
  ARCHIVED

  @@map("tenant_status")
}

enum TenantDomainType {
  PLATFORM_SUBDOMAIN
  CUSTOM
  ADMIN

  @@map("tenant_domain_type")
}

/// One paying school/customer organisation. Never hard-deleted through normal operations.
model Tenant {
  id               String       @id @default(uuid(7)) @db.Uuid
  /// Immutable machine key, e.g. WORLD_WAY.
  key              String       @unique @db.VarChar(40)
  /// URL slug; immutable once the tenant has been activated.
  slug             String       @unique @db.VarChar(63)
  displayName      String       @map("display_name") @db.VarChar(120)
  legalName        String?      @map("legal_name") @db.VarChar(200)
  status           TenantStatus @default(DRAFT)
  firstActivatedAt DateTime?    @map("first_activated_at") @db.Timestamptz(3)
  /// Set only on transition to ARCHIVED.
  archivedAt       DateTime?    @map("archived_at") @db.Timestamptz(3)
  createdAt        DateTime     @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt        DateTime     @updatedAt @map("updated_at") @db.Timestamptz(3)

  domains        TenantDomain[]
  branding       TenantBranding?
  features       TenantFeature[]
  configurations TenantConfiguration[]
  users          User[]
  auditLogs      AuditLog[]
  schools        School[]

  @@index([status])
  @@map("tenants")
}

model TenantDomain {
  id         String           @id @default(uuid(7)) @db.Uuid
  tenantId   String           @map("tenant_id") @db.Uuid
  /// Normalised lower-case host name, no scheme/port/path. Globally unique.
  domain     String           @unique @db.VarChar(253)
  type       TenantDomainType
  /// At most one primary per (tenant, type) — enforced by a partial unique index.
  isPrimary  Boolean          @default(false) @map("is_primary")
  /// Set manually by Platform Admin until DNS verification automation exists.
  verifiedAt DateTime?        @map("verified_at") @db.Timestamptz(3)
  createdAt  DateTime         @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt  DateTime         @updatedAt @map("updated_at") @db.Timestamptz(3)

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Restrict)

  @@index([tenantId])
  @@map("tenant_domains")
}

model TenantBranding {
  id                 String   @id @default(uuid(7)) @db.Uuid
  tenantId           String   @unique @map("tenant_id") @db.Uuid
  schoolName         String   @map("school_name") @db.VarChar(120)
  shortName          String?  @map("short_name") @db.VarChar(40)
  logoUrl            String?  @map("logo_url") @db.VarChar(2048)
  faviconUrl         String?  @map("favicon_url") @db.VarChar(2048)
  primaryColor       String   @map("primary_color") @db.Char(7)
  secondaryColor     String?  @map("secondary_color") @db.Char(7)
  accentColor        String?  @map("accent_color") @db.Char(7)
  backgroundImageUrl String?  @map("background_image_url") @db.VarChar(2048)
  loginImageUrl      String?  @map("login_image_url") @db.VarChar(2048)
  supportEmail       String?  @map("support_email") @db.VarChar(254)
  supportPhone       String?  @map("support_phone") @db.VarChar(20)
  websiteUrl         String?  @map("website_url") @db.VarChar(2048)
  footerText         String?  @map("footer_text") @db.VarChar(200)
  createdAt          DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt          DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Restrict)

  @@map("tenant_brandings")
}

/// One row per (tenant, feature) that has been explicitly configured. Keys are validated
/// against FEATURE_REGISTRY in @acadlyx/tenant-config; a missing row means disabled.
model TenantFeature {
  id         String   @id @default(uuid(7)) @db.Uuid
  tenantId   String   @map("tenant_id") @db.Uuid
  featureKey String   @map("feature_key") @db.VarChar(64)
  enabled    Boolean  @default(false)
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt  DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Restrict)

  @@unique([tenantId, featureKey])
  @@map("tenant_features")
}

/// Namespaced configuration overrides. Keys and value schemas are defined by
/// CONFIGURATION_REGISTRY in @acadlyx/tenant-config; a missing row means "use default".
model TenantConfiguration {
  id        String   @id @default(uuid(7)) @db.Uuid
  tenantId  String   @map("tenant_id") @db.Uuid
  key       String   @db.VarChar(100)
  value     Json
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Restrict)

  @@unique([tenantId, key])
  @@map("tenant_configurations")
}

// =============================================================================================
// Phase 3 — identity, authentication, RBAC, sessions, MFA, audit.
//
// Scopes (blueprint §10.1/§10.2): PlatformUser (Acadlyx staff, no tenant) and User (exactly one
// tenant). Shared security tables (sessions, refresh tokens, devices, MFA) carry a nullable
// tenant_id: platform rows have tenant_id NULL and are therefore invisible to the RLS-restricted
// tenant role. Composite (id, tenant_id) foreign keys make cross-tenant links impossible.
// =============================================================================================

enum AccountStatus {
  PENDING_ACTIVATION
  ACTIVE
  SUSPENDED
  DISABLED

  @@map("account_status")
}

enum AuthScope {
  PLATFORM
  TENANT

  @@map("auth_scope")
}

enum CredentialType {
  PASSWORD
  PIN

  @@map("credential_type")
}

enum LoginIdKind {
  STUDENT_ID
  EMPLOYEE_ID

  @@map("login_id_kind")
}

enum DevicePlatform {
  IOS
  ANDROID
  WEB

  @@map("device_platform")
}

enum OtpPurpose {
  ACCOUNT_ACTIVATION
  ACCOUNT_RECOVERY
  PHONE_CHANGE
  EMAIL_CHANGE
  NEW_DEVICE

  @@map("otp_purpose")
}

enum OtpChannel {
  SMS
  EMAIL
  ADMIN_ISSUED

  @@map("otp_channel")
}

enum MfaMethodType {
  TOTP
  WEBAUTHN

  @@map("mfa_method_type")
}

/// Code-registry-synced catalogue (see @acadlyx/permissions). Not tenant-owned.
model Role {
  id        String    @id @default(uuid(7)) @db.Uuid
  key       String    @unique @db.VarChar(64)
  name      String    @db.VarChar(100)
  scope     AuthScope
  isSystem  Boolean   @default(true) @map("is_system")
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)

  permissions   RolePermission[]
  userRoles     UserRole[]
  platformUsers PlatformUserRole[]

  @@unique([id, scope])
  @@map("roles")
}

model Permission {
  id          String    @id @default(uuid(7)) @db.Uuid
  key         String    @unique @db.VarChar(100)
  scope       AuthScope
  description String    @db.VarChar(255)
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)

  roles RolePermission[]

  @@unique([id, scope])
  @@map("permissions")
}

/// Role and permission must share a scope (composite FKs on (id, scope)).
model RolePermission {
  roleId       String    @map("role_id") @db.Uuid
  permissionId String    @map("permission_id") @db.Uuid
  scope        AuthScope

  role       Role       @relation(fields: [roleId, scope], references: [id, scope], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId, scope], references: [id, scope], onDelete: Cascade)

  @@id([roleId, permissionId])
  @@index([permissionId])
  @@map("role_permissions")
}

/// Acadlyx staff. Created only via the bootstrap CLI. Platform-path (owner role) only.
model PlatformUser {
  id                     String        @id @default(uuid(7)) @db.Uuid
  email                  String        @unique @db.VarChar(254)
  displayName            String        @map("display_name") @db.VarChar(120)
  status                 AccountStatus @default(PENDING_ACTIVATION)
  passwordHash           String?       @map("password_hash") @db.VarChar(255)
  credentialUpdatedAt    DateTime?     @map("credential_updated_at") @db.Timestamptz(3)
  failedLoginCount       Int           @default(0) @map("failed_login_count")
  lockoutCount           Int           @default(0) @map("lockout_count")
  lockoutWindowStartedAt DateTime?     @map("lockout_window_started_at") @db.Timestamptz(3)
  lockedUntil            DateTime?     @map("locked_until") @db.Timestamptz(3)
  lastLoginAt            DateTime?     @map("last_login_at") @db.Timestamptz(3)
  createdAt              DateTime      @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt              DateTime      @updatedAt @map("updated_at") @db.Timestamptz(3)

  roles         PlatformUserRole[]
  sessions      Session[]
  devices       UserDevice[]
  mfaMethods    MfaMethod[]
  recoveryCodes MfaRecoveryCode[]

  @@map("platform_users")
}

model PlatformUserRole {
  platformUserId String    @map("platform_user_id") @db.Uuid
  roleId         String    @map("role_id") @db.Uuid
  /// Always PLATFORM — enforced by CHECK and the (role_id, role_scope) FK.
  roleScope      AuthScope @default(PLATFORM) @map("role_scope")
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)

  platformUser PlatformUser @relation(fields: [platformUserId], references: [id], onDelete: Cascade)
  role         Role         @relation(fields: [roleId, roleScope], references: [id, scope], onDelete: Restrict)

  @@id([platformUserId, roleId])
  @@map("platform_user_roles")
}

/// School identity. Belongs to exactly one tenant; identifiers are unique per tenant.
model User {
  id                     String          @id @default(uuid(7)) @db.Uuid
  tenantId               String          @map("tenant_id") @db.Uuid
  status                 AccountStatus   @default(PENDING_ACTIVATION)
  displayName            String          @map("display_name") @db.VarChar(120)
  /// Lower-cased.
  email                  String?         @db.VarChar(254)
  /// E.164, e.g. +919876543210.
  phone                  String?         @db.VarChar(16)
  /// Student admission ID or staff employee ID, trimmed, case preserved (exact match).
  loginId                String?         @map("login_id") @db.VarChar(64)
  loginIdKind            LoginIdKind?    @map("login_id_kind")
  emailVerifiedAt        DateTime?       @map("email_verified_at") @db.Timestamptz(3)
  phoneVerifiedAt        DateTime?       @map("phone_verified_at") @db.Timestamptz(3)
  credentialType         CredentialType? @map("credential_type")
  /// Argon2id encoded hash of the password or PIN.
  credentialHash         String?         @map("credential_hash") @db.VarChar(255)
  credentialUpdatedAt    DateTime?       @map("credential_updated_at") @db.Timestamptz(3)
  failedLoginCount       Int             @default(0) @map("failed_login_count")
  lockoutCount           Int             @default(0) @map("lockout_count")
  lockoutWindowStartedAt DateTime?       @map("lockout_window_started_at") @db.Timestamptz(3)
  lockedUntil            DateTime?       @map("locked_until") @db.Timestamptz(3)
  lastLoginAt            DateTime?       @map("last_login_at") @db.Timestamptz(3)
  createdAt              DateTime        @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt              DateTime        @updatedAt @map("updated_at") @db.Timestamptz(3)

  tenant        Tenant            @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  roles         UserRole[]
  sessions      Session[]
  devices       UserDevice[]
  otpChallenges OtpChallenge[]
  mfaMethods    MfaMethod[]
  recoveryCodes MfaRecoveryCode[]
  student       Student?
  parent        Parent?
  teacher       Teacher?

  @@unique([id, tenantId])
  @@index([tenantId, status])
  @@map("users")
}

model UserRole {
  id                      String    @id @default(uuid(7)) @db.Uuid
  tenantId                String    @map("tenant_id") @db.Uuid
  userId                  String    @map("user_id") @db.Uuid
  roleId                  String    @map("role_id") @db.Uuid
  /// Always TENANT — a tenant user can never hold a PLATFORM role (CHECK + composite FK).
  roleScope               AuthScope @default(TENANT) @map("role_scope")
  createdAt               DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  createdByPlatformUserId String?   @map("created_by_platform_user_id") @db.Uuid

  user User @relation(fields: [userId, tenantId], references: [id, tenantId], onDelete: Cascade)
  role Role @relation(fields: [roleId, roleScope], references: [id, scope], onDelete: Restrict)

  @@unique([userId, roleId])
  @@index([tenantId])
  @@map("user_roles")
}

model UserDevice {
  id               String         @id @default(uuid(7)) @db.Uuid
  scope            AuthScope
  tenantId         String?        @map("tenant_id") @db.Uuid
  userId           String?        @map("user_id") @db.Uuid
  platformUserId   String?        @map("platform_user_id") @db.Uuid
  /// SHA-256 of the app-generated installation ID (the raw ID is never stored).
  installationHash String         @map("installation_hash") @db.Char(64)
  platform         DevicePlatform
  label            String?        @db.VarChar(100)
  firstSeenAt      DateTime       @default(now()) @map("first_seen_at") @db.Timestamptz(3)
  lastSeenAt       DateTime       @default(now()) @map("last_seen_at") @db.Timestamptz(3)
  revokedAt        DateTime?      @map("revoked_at") @db.Timestamptz(3)

  user         User?         @relation(fields: [userId, tenantId], references: [id, tenantId], onDelete: Cascade)
  platformUser PlatformUser? @relation(fields: [platformUserId], references: [id], onDelete: Cascade)
  sessions     Session[]

  @@unique([userId, installationHash])
  @@unique([platformUserId, installationHash])
  @@unique([id, tenantId])
  @@index([tenantId])
  @@map("user_devices")
}

model Session {
  id                String    @id @default(uuid(7)) @db.Uuid
  scope             AuthScope
  tenantId          String?   @map("tenant_id") @db.Uuid
  userId            String?   @map("user_id") @db.Uuid
  platformUserId    String?   @map("platform_user_id") @db.Uuid
  deviceId          String?   @map("device_id") @db.Uuid
  /// true until the MFA step completes; no refresh token exists while pending.
  mfaPending        Boolean   @default(false) @map("mfa_pending")
  mfaFailedAttempts Int       @default(0) @map("mfa_failed_attempts")
  createdAt         DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  lastActiveAt      DateTime  @default(now()) @map("last_active_at") @db.Timestamptz(3)
  idleExpiresAt     DateTime  @map("idle_expires_at") @db.Timestamptz(3)
  absoluteExpiresAt DateTime  @map("absolute_expires_at") @db.Timestamptz(3)
  revokedAt         DateTime? @map("revoked_at") @db.Timestamptz(3)
  revocationReason  String?   @map("revocation_reason") @db.VarChar(64)
  ipAddress         String?   @map("ip_address") @db.VarChar(45)
  userAgent         String?   @map("user_agent") @db.VarChar(255)

  user                User?          @relation(fields: [userId, tenantId], references: [id, tenantId], onDelete: Cascade)
  platformUser        PlatformUser?  @relation(fields: [platformUserId], references: [id], onDelete: Cascade)
  device              UserDevice?    @relation(fields: [deviceId, tenantId], references: [id, tenantId], onDelete: Restrict)
  refreshTokens       RefreshToken[] @relation("RefreshTokenSession")
  tenantRefreshTokens RefreshToken[] @relation("RefreshTokenTenantSession")

  @@unique([id, tenantId])
  @@index([userId, revokedAt])
  @@index([platformUserId, revokedAt])
  @@index([tenantId])
  @@index([deviceId])
  @@map("sessions")
}

/// One row per issued refresh token; the session is the rotation family.
model RefreshToken {
  id        String    @id @default(uuid(7)) @db.Uuid
  sessionId String    @map("session_id") @db.Uuid
  tenantId  String?   @map("tenant_id") @db.Uuid
  /// SHA-256 of the 256-bit random token (raw token never stored).
  tokenHash String    @unique @map("token_hash") @db.Char(64)
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  /// Set when rotated; presenting a rotated token again = reuse → family revoked.
  rotatedAt DateTime? @map("rotated_at") @db.Timestamptz(3)

  /// Always resolvable (platform rows have tenant_id NULL).
  session       Session  @relation("RefreshTokenSession", fields: [sessionId], references: [id], onDelete: Cascade)
  /// Tenant consistency: a tenant token's tenant_id must equal its session's tenant_id.
  tenantSession Session? @relation("RefreshTokenTenantSession", fields: [sessionId, tenantId], references: [id, tenantId], onDelete: Cascade)

  @@index([sessionId])
  @@index([tenantId])
  @@map("refresh_tokens")
}

model OtpChallenge {
  id           String     @id @default(uuid(7)) @db.Uuid
  tenantId     String     @map("tenant_id") @db.Uuid
  userId       String     @map("user_id") @db.Uuid
  purpose      OtpPurpose
  channel      OtpChannel
  /// Normalised phone/email the code was sent to (the new value for *_CHANGE purposes).
  target       String     @db.VarChar(254)
  /// HMAC-SHA256(code) with the active OTP key; `<kid>:<hex>`.
  codeHmac     String     @map("code_hmac") @db.VarChar(100)
  expiresAt    DateTime   @map("expires_at") @db.Timestamptz(3)
  attempts     Int        @default(0)
  maxAttempts  Int        @map("max_attempts")
  verifiedAt   DateTime?  @map("verified_at") @db.Timestamptz(3)
  /// Set when the follow-up step (e.g. set PIN) used this verification — single use.
  completedAt  DateTime?  @map("completed_at") @db.Timestamptz(3)
  supersededAt DateTime?  @map("superseded_at") @db.Timestamptz(3)
  createdAt    DateTime   @default(now()) @map("created_at") @db.Timestamptz(3)

  user User @relation(fields: [userId, tenantId], references: [id, tenantId], onDelete: Cascade)

  @@index([userId, purpose])
  @@index([tenantId])
  @@map("otp_challenges")
}

model MfaMethod {
  id              String        @id @default(uuid(7)) @db.Uuid
  scope           AuthScope
  tenantId        String?       @map("tenant_id") @db.Uuid
  userId          String?       @map("user_id") @db.Uuid
  platformUserId  String?       @map("platform_user_id") @db.Uuid
  type            MfaMethodType
  /// AES-256-GCM `v1:<kid>:<iv>:<ciphertext>:<tag>`; never plaintext.
  secretEncrypted String        @map("secret_encrypted") @db.Text
  /// Last accepted TOTP time-step (replay protection).
  lastUsedStep    BigInt?       @map("last_used_step")
  verifiedAt      DateTime?     @map("verified_at") @db.Timestamptz(3)
  createdAt       DateTime      @default(now()) @map("created_at") @db.Timestamptz(3)

  user         User?         @relation(fields: [userId, tenantId], references: [id, tenantId], onDelete: Cascade)
  platformUser PlatformUser? @relation(fields: [platformUserId], references: [id], onDelete: Cascade)

  @@unique([userId, type])
  @@unique([platformUserId, type])
  @@index([tenantId])
  @@map("mfa_methods")
}

model MfaRecoveryCode {
  id             String    @id @default(uuid(7)) @db.Uuid
  scope          AuthScope
  tenantId       String?   @map("tenant_id") @db.Uuid
  userId         String?   @map("user_id") @db.Uuid
  platformUserId String?   @map("platform_user_id") @db.Uuid
  /// HMAC-SHA256 of the normalised code; `<kid>:<hex>`.
  codeHmac       String    @map("code_hmac") @db.VarChar(100)
  usedAt         DateTime? @map("used_at") @db.Timestamptz(3)
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)

  user         User?         @relation(fields: [userId, tenantId], references: [id, tenantId], onDelete: Cascade)
  platformUser PlatformUser? @relation(fields: [platformUserId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([platformUserId])
  @@index([tenantId])
  @@map("mfa_recovery_codes")
}

/// Tenant security/audit events (append-only for the tenant role; RLS by tenant).
model AuditLog {
  id            String   @id @default(uuid(7)) @db.Uuid
  tenantId      String   @map("tenant_id") @db.Uuid
  actorUserId   String?  @map("actor_user_id") @db.Uuid
  actorLabel    String   @map("actor_label") @db.VarChar(100)
  action        String   @db.VarChar(64)
  resourceType  String   @map("resource_type") @db.VarChar(64)
  resourceId    String?  @map("resource_id") @db.VarChar(64)
  requestId     String?  @map("request_id") @db.VarChar(128)
  ipAddress     String?  @map("ip_address") @db.VarChar(45)
  userAgent     String?  @map("user_agent") @db.VarChar(255)
  changedFields String[] @map("changed_fields")
  metadata      Json?
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Restrict)

  @@index([tenantId, createdAt])
  @@index([actorUserId])
  @@map("audit_logs")
}

/// Platform-scope audit (blueprint §10.1). Platform path only; invisible to the tenant role.
model PlatformAuditLog {
  id                  String   @id @default(uuid(7)) @db.Uuid
  actorPlatformUserId String?  @map("actor_platform_user_id") @db.Uuid
  actorLabel          String   @map("actor_label") @db.VarChar(100)
  tenantId            String?  @map("tenant_id") @db.Uuid
  action              String   @db.VarChar(64)
  resourceType        String   @map("resource_type") @db.VarChar(64)
  resourceId          String?  @map("resource_id") @db.VarChar(64)
  requestId           String?  @map("request_id") @db.VarChar(128)
  ipAddress           String?  @map("ip_address") @db.VarChar(45)
  userAgent           String?  @map("user_agent") @db.VarChar(255)
  changedFields       String[] @map("changed_fields")
  metadata            Json?
  createdAt           DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  @@index([createdAt])
  @@index([tenantId])
  @@index([actorPlatformUserId])
  @@map("platform_audit_logs")
}

// =============================================================================================
// Phase 4 — school & academic configuration.
//
// Tenant (SaaS customer) → School (academic institution; V1 exactly one per tenant, schema allows
// more) → Branch (campus), AcademicYear, Grade (permanent catalogue), Subject → Section (a grade at
// one branch for one academic year) and GradeSubject (which subjects a grade offers).
// Every table carries tenant_id and school_id; composite (id, school_id, tenant_id) foreign keys
// make cross-tenant AND cross-school links impossible at the database level. Normal
// administration deactivates (is_active) instead of deleting: later phases reference these ids.
// See docs/architecture/SCHOOL_ACADEMIC_MODEL.md.
// =============================================================================================

enum SchoolBoard {
  CBSE
  ICSE
  STATE_BOARD
  IB
  CAMBRIDGE
  OTHER

  @@map("school_board")
}

enum Weekday {
  MONDAY
  TUESDAY
  WEDNESDAY
  THURSDAY
  FRIDAY
  SATURDAY
  SUNDAY

  @@map("weekday")
}

/// PLANNED → ACTIVE → CLOSED (one-way). Only an ACTIVE year may be current.
enum AcademicYearStatus {
  PLANNED
  ACTIVE
  CLOSED

  @@map("academic_year_status")
}

/// Academic/business identity of a school. White-label branding stays on TenantBranding.
model School {
  id                     String       @id @default(uuid(7)) @db.Uuid
  tenantId               String       @map("tenant_id") @db.Uuid
  name                   String       @db.VarChar(160)
  shortName              String?      @map("short_name") @db.VarChar(40)
  /// Upper-case internal code, unique within the tenant (partial unique index). Not an identifier.
  code                   String?      @db.VarChar(20)
  board                  SchoolBoard?
  /// Only when board = OTHER (CHECK).
  boardName              String?      @map("board_name") @db.VarChar(100)
  email                  String?      @db.VarChar(254)
  phone                  String?      @db.VarChar(20)
  website                String?      @db.VarChar(2048)
  addressLine1           String?      @map("address_line1") @db.VarChar(200)
  addressLine2           String?      @map("address_line2") @db.VarChar(200)
  city                   String?      @db.VarChar(100)
  state                  String?      @db.VarChar(100)
  postalCode             String?      @map("postal_code") @db.VarChar(12)
  /// ISO 3166-1 alpha-2.
  country                String?      @db.Char(2)
  // ---- Academic settings (school-level behaviour; typed columns, not a JSON bag) ----
  /// Default IANA time zone for new branches.
  timezone               String       @db.VarChar(64)
  weekStartDay           Weekday      @default(MONDAY) @map("week_start_day")
  workingDays            Weekday[]    @map("working_days")
  academicYearStartMonth Int          @default(4) @map("academic_year_start_month") @db.SmallInt
  createdAt              DateTime     @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt              DateTime     @updatedAt @map("updated_at") @db.Timestamptz(3)

  tenant        Tenant          @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  branches      Branch[]
  academicYears AcademicYear[]
  grades        Grade[]
  subjects      Subject[]
  students      Student[]
  parents       Parent[]
  teachers      Teacher[]
  importJobs    BulkImportJob[]

  @@unique([id, tenantId])
  @@index([tenantId])
  @@map("schools")
}

model Branch {
  id           String   @id @default(uuid(7)) @db.Uuid
  tenantId     String   @map("tenant_id") @db.Uuid
  schoolId     String   @map("school_id") @db.Uuid
  name         String   @db.VarChar(120)
  /// Upper-case, unique within the school.
  code         String   @db.VarChar(20)
  email        String?  @db.VarChar(254)
  phone        String?  @db.VarChar(20)
  addressLine1 String?  @map("address_line1") @db.VarChar(200)
  addressLine2 String?  @map("address_line2") @db.VarChar(200)
  city         String?  @db.VarChar(100)
  state        String?  @db.VarChar(100)
  postalCode   String?  @map("postal_code") @db.VarChar(12)
  country      String?  @db.Char(2)
  /// Effective IANA time zone of this campus (stored explicitly, never inferred from the server).
  timezone     String   @db.VarChar(64)
  /// Exactly one primary per school once any branch exists (partial unique index + service).
  isPrimary    Boolean  @default(false) @map("is_primary")
  isActive     Boolean  @default(true) @map("is_active")
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt    DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  school   School    @relation(fields: [schoolId, tenantId], references: [id, tenantId], onDelete: Restrict)
  sections Section[]

  @@unique([schoolId, code])
  @@unique([id, schoolId, tenantId])
  @@index([tenantId, schoolId])
  @@map("branches")
}

model AcademicYear {
  id        String             @id @default(uuid(7)) @db.Uuid
  tenantId  String             @map("tenant_id") @db.Uuid
  schoolId  String             @map("school_id") @db.Uuid
  name      String             @db.VarChar(40)
  /// Date-only (no time zone). start < end; ranges never overlap within a school (EXCLUDE).
  startDate DateTime           @map("start_date") @db.Date
  endDate   DateTime           @map("end_date") @db.Date
  status    AcademicYearStatus @default(PLANNED)
  /// At most one per school (partial unique index); only when ACTIVE (CHECK).
  isCurrent Boolean            @default(false) @map("is_current")
  createdAt DateTime           @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime           @updatedAt @map("updated_at") @db.Timestamptz(3)

  school   School    @relation(fields: [schoolId, tenantId], references: [id, tenantId], onDelete: Restrict)
  sections Section[]

  @@unique([schoolId, name])
  @@unique([id, schoolId, tenantId])
  @@index([tenantId, schoolId])
  @@map("academic_years")
}

/// Permanent grade/class catalogue of a school (not versioned per year).
model Grade {
  id           String   @id @default(uuid(7)) @db.Uuid
  tenantId     String   @map("tenant_id") @db.Uuid
  schoolId     String   @map("school_id") @db.Uuid
  name         String   @db.VarChar(60)
  code         String   @db.VarChar(20)
  /// Explicit order (Nursery, LKG, Grade 1 … Grade 12) — never alphabetical. Unique per school
  /// (deferrable constraint so a reorder can permute values inside one transaction).
  displayOrder Int      @map("display_order")
  isActive     Boolean  @default(true) @map("is_active")
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt    DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  school        School         @relation(fields: [schoolId, tenantId], references: [id, tenantId], onDelete: Restrict)
  sections      Section[]
  gradeSubjects GradeSubject[]

  @@unique([schoolId, code])
  @@unique([id, schoolId, tenantId])
  @@index([tenantId, schoolId])
  @@map("grades")
}

/// A grade's section at one branch for one academic year, e.g. Grade 5 · A · Main Campus · 2026–27.
model Section {
  id             String   @id @default(uuid(7)) @db.Uuid
  tenantId       String   @map("tenant_id") @db.Uuid
  schoolId       String   @map("school_id") @db.Uuid
  branchId       String   @map("branch_id") @db.Uuid
  academicYearId String   @map("academic_year_id") @db.Uuid
  gradeId        String   @map("grade_id") @db.Uuid
  name           String   @db.VarChar(40)
  code           String   @db.VarChar(20)
  displayOrder   Int      @map("display_order")
  /// Optional; > 0 when set.
  capacity       Int?
  isActive       Boolean  @default(true) @map("is_active")
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt      DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  branch       Branch              @relation(fields: [branchId, schoolId, tenantId], references: [id, schoolId, tenantId], onDelete: Restrict)
  academicYear AcademicYear        @relation(fields: [academicYearId, schoolId, tenantId], references: [id, schoolId, tenantId], onDelete: Restrict)
  grade        Grade               @relation(fields: [gradeId, schoolId, tenantId], references: [id, schoolId, tenantId], onDelete: Restrict)
  enrollments  StudentEnrollment[]
  assignments  TeacherAssignment[]

  @@unique([branchId, academicYearId, gradeId, code])
  @@unique([id, schoolId, tenantId])
  /// Phase 5: lets an enrollment pin its denormalised academic_year_id to its section's year.
  @@unique([id, academicYearId, schoolId, tenantId])
  @@index([tenantId, gradeId])
  @@index([tenantId, branchId, academicYearId])
  @@index([academicYearId, schoolId, tenantId])
  @@index([gradeId, schoolId, tenantId])
  @@index([branchId, schoolId, tenantId])
  @@map("sections")
}

model Subject {
  id        String   @id @default(uuid(7)) @db.Uuid
  tenantId  String   @map("tenant_id") @db.Uuid
  schoolId  String   @map("school_id") @db.Uuid
  name      String   @db.VarChar(100)
  code      String   @db.VarChar(20)
  isActive  Boolean  @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  school        School              @relation(fields: [schoolId, tenantId], references: [id, tenantId], onDelete: Restrict)
  gradeSubjects GradeSubject[]
  assignments   TeacherAssignment[]

  @@unique([schoolId, code])
  @@unique([id, schoolId, tenantId])
  @@index([tenantId, schoolId])
  @@map("subjects")
}

/// Which subjects a grade offers. A mapping row (not historical data), so it may be removed.
model GradeSubject {
  id           String   @id @default(uuid(7)) @db.Uuid
  tenantId     String   @map("tenant_id") @db.Uuid
  schoolId     String   @map("school_id") @db.Uuid
  gradeId      String   @map("grade_id") @db.Uuid
  subjectId    String   @map("subject_id") @db.Uuid
  isRequired   Boolean  @default(true) @map("is_required")
  displayOrder Int      @default(0) @map("display_order")
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt    DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  grade   Grade   @relation(fields: [gradeId, schoolId, tenantId], references: [id, schoolId, tenantId], onDelete: Restrict)
  subject Subject @relation(fields: [subjectId, schoolId, tenantId], references: [id, schoolId, tenantId], onDelete: Restrict)

  @@unique([gradeId, subjectId])
  @@index([tenantId, gradeId])
  @@index([subjectId, schoolId, tenantId])
  @@map("grade_subjects")
}

// =============================================================================================
// Phase 5 — people, enrollment and bulk onboarding.
//
// Profiles (Student, Parent, Teacher) are school-domain records, separate from the Phase 3 login
// identity (User). A profile may exist without a login (user_id NULL); when linked, the composite
// FK (user_id, tenant_id) keeps the User in the same tenant and user_id is unique per profile
// kind. Every table carries tenant_id + school_id with composite FKs, so cross-tenant AND
// cross-school links are impossible. See docs/architecture/PEOPLE_AND_ENROLLMENT_MODEL.md.
// =============================================================================================

/// ACTIVE ⇄ INACTIVE; ACTIVE/INACTIVE → WITHDRAWN | GRADUATED; WITHDRAWN → ACTIVE (re-admission).
/// GRADUATED is terminal. Independent of the login account status.
enum StudentStatus {
  ACTIVE
  INACTIVE
  WITHDRAWN
  GRADUATED

  @@map("student_status")
}

enum TeacherStatus {
  ACTIVE
  INACTIVE

  @@map("teacher_status")
}

enum GuardianRelationship {
  FATHER
  MOTHER
  GUARDIAN
  GRANDPARENT
  SIBLING
  OTHER

  @@map("guardian_relationship")
}

/// At most one ACTIVE enrollment per student per academic year. Rows are never deleted.
enum EnrollmentStatus {
  ACTIVE
  TRANSFERRED
  WITHDRAWN
  COMPLETED

  @@map("enrollment_status")
}

enum TeacherAssignmentType {
  SUBJECT_TEACHER
  CLASS_TEACHER

  @@map("teacher_assignment_type")
}

enum ImportType {
  STUDENTS
  PARENTS
  TEACHERS

  @@map("import_type")
}

/// READY (parsed + validated, awaiting confirmation) → QUEUED → PROCESSING → COMPLETED | FAILED;
/// READY → CANCELLED.
enum ImportStatus {
  READY
  QUEUED
  PROCESSING
  COMPLETED
  FAILED
  CANCELLED

  @@map("import_status")
}

/// INVALID rows are never processed; VALID → SUCCEEDED | FAILED once processed.
enum ImportRowStatus {
  INVALID
  VALID
  SUCCEEDED
  FAILED

  @@map("import_row_status")
}

model Student {
  id              String        @id @default(uuid(7)) @db.Uuid
  tenantId        String        @map("tenant_id") @db.Uuid
  schoolId        String        @map("school_id") @db.Uuid
  /// Optional login identity (same tenant; one Student profile per User).
  userId          String?       @map("user_id") @db.Uuid
  /// Trimmed, upper-case; unique within the school (not globally).
  admissionNumber String        @map("admission_number") @db.VarChar(40)
  firstName       String        @map("first_name") @db.VarChar(80)
  middleName      String?       @map("middle_name") @db.VarChar(80)
  lastName        String?       @map("last_name") @db.VarChar(80)
  preferredName   String?       @map("preferred_name") @db.VarChar(80)
  /// Date-only.
  dateOfBirth     DateTime?     @map("date_of_birth") @db.Date
  admissionDate   DateTime?     @map("admission_date") @db.Date
  status          StudentStatus @default(ACTIVE)
  createdAt       DateTime      @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt       DateTime      @updatedAt @map("updated_at") @db.Timestamptz(3)

  school        School                 @relation(fields: [schoolId, tenantId], references: [id, tenantId], onDelete: Restrict)
  user          User?                  @relation(fields: [userId, tenantId], references: [id, tenantId], onDelete: Restrict)
  guardians     StudentGuardian[]
  enrollments   StudentEnrollment[]
  statusHistory StudentStatusHistory[]

  /// One Student profile per login User (a user id belongs to exactly one tenant).
  @@unique([userId, tenantId])
  @@unique([schoolId, admissionNumber])
  @@unique([id, schoolId, tenantId])
  @@index([tenantId, schoolId, status])
  @@index([schoolId, lastName, firstName])
  @@map("students")
}

/// Append-only record of Student status changes (blueprint §10.4 StudentStatusHistory).
model StudentStatusHistory {
  id              String         @id @default(uuid(7)) @db.Uuid
  tenantId        String         @map("tenant_id") @db.Uuid
  schoolId        String         @map("school_id") @db.Uuid
  studentId       String         @map("student_id") @db.Uuid
  fromStatus      StudentStatus? @map("from_status")
  toStatus        StudentStatus  @map("to_status")
  reason          String?        @db.VarChar(200)
  changedByUserId String?        @map("changed_by_user_id") @db.Uuid
  createdAt       DateTime       @default(now()) @map("created_at") @db.Timestamptz(3)

  student Student @relation(fields: [studentId, schoolId, tenantId], references: [id, schoolId, tenantId], onDelete: Restrict)

  @@index([studentId, createdAt])
  @@index([tenantId])
  @@map("student_status_history")
}

model Parent {
  id         String   @id @default(uuid(7)) @db.Uuid
  tenantId   String   @map("tenant_id") @db.Uuid
  schoolId   String   @map("school_id") @db.Uuid
  userId     String?  @map("user_id") @db.Uuid
  /// Optional school-unique import/dedup key (e.g. PAR-0001). Imports match parents ONLY by this.
  parentCode String?  @map("parent_code") @db.VarChar(40)
  firstName  String   @map("first_name") @db.VarChar(80)
  middleName String?  @map("middle_name") @db.VarChar(80)
  lastName   String?  @map("last_name") @db.VarChar(80)
  /// Contact data only — NOT unique (families may share a phone/email). Login uniqueness is on User.
  email      String?  @db.VarChar(254)
  phone      String?  @db.VarChar(16)
  isActive   Boolean  @default(true) @map("is_active")
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt  DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  school   School            @relation(fields: [schoolId, tenantId], references: [id, tenantId], onDelete: Restrict)
  user     User?             @relation(fields: [userId, tenantId], references: [id, tenantId], onDelete: Restrict)
  children StudentGuardian[]

  @@unique([userId, tenantId])
  @@unique([id, schoolId, tenantId])
  @@index([tenantId, schoolId])
  @@index([schoolId, lastName, firstName])
  @@index([schoolId, phone])
  @@map("parents")
}

model StudentGuardian {
  id                 String               @id @default(uuid(7)) @db.Uuid
  tenantId           String               @map("tenant_id") @db.Uuid
  schoolId           String               @map("school_id") @db.Uuid
  studentId          String               @map("student_id") @db.Uuid
  parentId           String               @map("parent_id") @db.Uuid
  relationship       GuardianRelationship
  /// At most one primary guardian per student (partial unique index).
  isPrimary          Boolean              @default(false) @map("is_primary")
  pickupAuthorized   Boolean              @default(false) @map("pickup_authorized")
  isEmergencyContact Boolean              @default(false) @map("is_emergency_contact")
  createdAt          DateTime             @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt          DateTime             @updatedAt @map("updated_at") @db.Timestamptz(3)

  student Student @relation(fields: [studentId, schoolId, tenantId], references: [id, schoolId, tenantId], onDelete: Restrict)
  parent  Parent  @relation(fields: [parentId, schoolId, tenantId], references: [id, schoolId, tenantId], onDelete: Restrict)

  @@unique([studentId, parentId])
  @@index([parentId])
  @@index([tenantId])
  @@map("student_guardians")
}

model Teacher {
  id          String        @id @default(uuid(7)) @db.Uuid
  tenantId    String        @map("tenant_id") @db.Uuid
  schoolId    String        @map("school_id") @db.Uuid
  userId      String?       @map("user_id") @db.Uuid
  /// Trimmed, upper-case; unique within the school.
  employeeId  String        @map("employee_id") @db.VarChar(40)
  firstName   String        @map("first_name") @db.VarChar(80)
  middleName  String?       @map("middle_name") @db.VarChar(80)
  lastName    String?       @map("last_name") @db.VarChar(80)
  email       String?       @db.VarChar(254)
  phone       String?       @db.VarChar(16)
  joiningDate DateTime?     @map("joining_date") @db.Date
  status      TeacherStatus @default(ACTIVE)
  createdAt   DateTime      @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime      @updatedAt @map("updated_at") @db.Timestamptz(3)

  school      School              @relation(fields: [schoolId, tenantId], references: [id, tenantId], onDelete: Restrict)
  user        User?               @relation(fields: [userId, tenantId], references: [id, tenantId], onDelete: Restrict)
  assignments TeacherAssignment[]

  @@unique([userId, tenantId])
  @@unique([schoolId, employeeId])
  @@unique([id, schoolId, tenantId])
  @@index([tenantId, schoolId, status])
  @@index([schoolId, lastName, firstName])
  @@map("teachers")
}

/// A student's placement in a Section (which pins branch, year and grade). academic_year_id is
/// denormalised for the one-ACTIVE-per-year rule and kept equal to the section's year by the
/// composite FK (section_id, academic_year_id, school_id, tenant_id).
model StudentEnrollment {
  id             String           @id @default(uuid(7)) @db.Uuid
  tenantId       String           @map("tenant_id") @db.Uuid
  schoolId       String           @map("school_id") @db.Uuid
  studentId      String           @map("student_id") @db.Uuid
  sectionId      String           @map("section_id") @db.Uuid
  academicYearId String           @map("academic_year_id") @db.Uuid
  status         EnrollmentStatus @default(ACTIVE)
  /// Date-only.
  startDate      DateTime         @map("start_date") @db.Date
  endDate        DateTime?        @map("end_date") @db.Date
  createdAt      DateTime         @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt      DateTime         @updatedAt @map("updated_at") @db.Timestamptz(3)

  student Student @relation(fields: [studentId, schoolId, tenantId], references: [id, schoolId, tenantId], onDelete: Restrict)
  section Section @relation(fields: [sectionId, academicYearId, schoolId, tenantId], references: [id, academicYearId, schoolId, tenantId], onDelete: Restrict)

  @@index([studentId, academicYearId])
  @@index([sectionId, status])
  @@index([tenantId, academicYearId])
  @@map("student_enrollments")
}

/// SUBJECT_TEACHER (subject required; must be mapped to the section's grade) or CLASS_TEACHER
/// (no subject; at most one active per section). Ending sets ended_at — history is kept.
model TeacherAssignment {
  id        String                @id @default(uuid(7)) @db.Uuid
  tenantId  String                @map("tenant_id") @db.Uuid
  schoolId  String                @map("school_id") @db.Uuid
  teacherId String                @map("teacher_id") @db.Uuid
  sectionId String                @map("section_id") @db.Uuid
  subjectId String?               @map("subject_id") @db.Uuid
  type      TeacherAssignmentType
  startedAt DateTime              @default(now()) @map("started_at") @db.Timestamptz(3)
  endedAt   DateTime?             @map("ended_at") @db.Timestamptz(3)
  createdAt DateTime              @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime              @updatedAt @map("updated_at") @db.Timestamptz(3)

  teacher Teacher  @relation(fields: [teacherId, schoolId, tenantId], references: [id, schoolId, tenantId], onDelete: Restrict)
  section Section  @relation(fields: [sectionId, schoolId, tenantId], references: [id, schoolId, tenantId], onDelete: Restrict)
  subject Subject? @relation(fields: [subjectId, schoolId, tenantId], references: [id, schoolId, tenantId], onDelete: Restrict)

  @@index([teacherId, endedAt])
  @@index([sectionId, endedAt])
  @@index([subjectId])
  @@index([tenantId])
  @@map("teacher_assignments")
}

/// One upload. The original file is never stored — only normalised rows (bulk_import_rows).
model BulkImportJob {
  id               String       @id @default(uuid(7)) @db.Uuid
  tenantId         String       @map("tenant_id") @db.Uuid
  schoolId         String       @map("school_id") @db.Uuid
  type             ImportType
  status           ImportStatus @default(READY)
  templateVersion  Int          @map("template_version") @db.SmallInt
  originalFilename String       @map("original_filename") @db.VarChar(200)
  /// SHA-256 of the uploaded bytes (duplicate-upload hint; file itself discarded).
  fileHash         String       @map("file_hash") @db.Char(64)
  totalRows        Int          @default(0) @map("total_rows")
  validRows        Int          @default(0) @map("valid_rows")
  invalidRows      Int          @default(0) @map("invalid_rows")
  processedRows    Int          @default(0) @map("processed_rows")
  succeededRows    Int          @default(0) @map("succeeded_rows")
  failedRows       Int          @default(0) @map("failed_rows")
  /// Safe, generic reason when the whole job FAILED (never raw errors).
  failureReason    String?      @map("failure_reason") @db.VarChar(200)
  createdByUserId  String       @map("created_by_user_id") @db.Uuid
  createdAt        DateTime     @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt        DateTime     @updatedAt @map("updated_at") @db.Timestamptz(3)
  confirmedAt      DateTime?    @map("confirmed_at") @db.Timestamptz(3)
  startedAt        DateTime?    @map("started_at") @db.Timestamptz(3)
  completedAt      DateTime?    @map("completed_at") @db.Timestamptz(3)

  school School          @relation(fields: [schoolId, tenantId], references: [id, tenantId], onDelete: Restrict)
  rows   BulkImportRow[]

  @@unique([id, schoolId, tenantId])
  @@index([tenantId, schoolId, createdAt])
  @@index([tenantId, status])
  @@map("bulk_import_jobs")
}

model BulkImportRow {
  id          String          @id @default(uuid(7)) @db.Uuid
  tenantId    String          @map("tenant_id") @db.Uuid
  schoolId    String          @map("school_id") @db.Uuid
  jobId       String          @map("job_id") @db.Uuid
  /// Spreadsheet row number (header = row 1).
  rowNumber   Int             @map("row_number")
  status      ImportRowStatus
  /// Normalised values needed to process the row; cleared once the row succeeded.
  data        Json?
  /// [{ field, code, message }] — never raw database errors.
  errors      Json?
  /// Created profile id once processed.
  entityId    String?         @map("entity_id") @db.Uuid
  processedAt DateTime?       @map("processed_at") @db.Timestamptz(3)

  job BulkImportJob @relation(fields: [jobId, schoolId, tenantId], references: [id, schoolId, tenantId], onDelete: Restrict)

  @@unique([jobId, rowNumber])
  @@index([jobId, status])
  @@index([tenantId])
  @@map("bulk_import_rows")
}
