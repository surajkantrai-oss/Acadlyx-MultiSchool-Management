# Acadlyx mobile — copy to .env. EXPO_PUBLIC_* values are bundled into the app; never put secrets here.
# On a physical device use your machine's LAN IP instead of localhost.
EXPO_PUBLIC_API_BASE_URL=http://localhost:4000/api/v1

# White-label variant = which school this build is for (white-label/<name>.json): sets the public
# tenant key, app name, bundle id/package. One school per build; no in-app school picker.
# Leave empty in development for the neutral "not configured" screen. Example: school-a.
ACADLYX_TENANT=
