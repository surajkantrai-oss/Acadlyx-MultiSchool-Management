    "clean": "rm -rf .next",
    "test:e2e": "vitest run"
  },
  "dependencies": {
    "@acadlyx/api-client": "workspace:*",
    "@acadlyx/constants": "workspace:*",
    "@acadlyx/tenant-config": "workspace:*",
    "@acadlyx/validation": "workspace:*",
    "@acadlyx/web-ui": "workspace:*",
    "next": "16.3.6",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "server-only": "0.0.1"
  },
  "devDependencies": {
    "@eslint/js": "9.39.5",
    "@tailwindcss/postcss": "4.3.3",
    "@types/node": "22.20.4",
    "@types/pg": "8.23.1",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.7",
    "eslint": "9.39.5",
    "eslint-config-next": "16.3.6",
    "pg": "8.23.0",
    "tailwindcss": "4.3.3",
    "typescript": "6.0.3",
    "vitest": "4.1.11"
  }
