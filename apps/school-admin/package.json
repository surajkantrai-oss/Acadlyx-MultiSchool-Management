{
  "name": "@acadlyx/school-admin",
  "version": "0.1.0",
  "private": true,
  "description": "White-label administration portal used by each school.",
  "type": "module",
  "scripts": {
    "dev": "next dev --port 4002",
    "build": "next build",
    "start": "next start --port 4002",
    "lint": "eslint . --max-warnings 0",
