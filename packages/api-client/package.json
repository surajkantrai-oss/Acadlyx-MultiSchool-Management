{
  "name": "@acadlyx/api-client",
  "version": "0.0.0",
  "private": true,
  "description": "Typed HTTP client foundation for Acadlyx web and mobile apps.",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint src --max-warnings 0",
    "clean": "rm -rf dist *.tsbuildinfo",
    "test": "vitest run"
  },
  "dependencies": {
    "@acadlyx/constants": "workspace:*",
    "@acadlyx/types": "workspace:*",
    "@acadlyx/utils": "workspace:*",
    "@acadlyx/tenant-config": "workspace:*"
  },
  "devDependencies": {
    "typescript": "6.0.3",
    "vitest": "4.1.11"
  }
}
