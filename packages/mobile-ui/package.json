{
  "name": "@acadlyx/mobile-ui",
  "version": "0.0.0",
  "private": true,
  "description": "Generic React Native UI primitives for the Acadlyx mobile app.",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint src --max-warnings 0",
    "clean": "rm -rf dist *.tsbuildinfo"
  },
  "peerDependencies": {
    "react": "^19.2.0",
    "react-native": ">=0.86.0"
  },
  "devDependencies": {
    "typescript": "6.0.3",
    "react": "19.2.3",
    "react-native": "0.86.3",
    "@types/react": "19.2.18"
  }
}
